# --- LiveKit (https://cloud.livekit.io -> Project -> Settings -> Keys) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- Room storage: Upstash Redis / Vercel KV (REST credentials) ---
# Either of these pairs works. Vercel's "Upstash for Redis" integration sets the KV_* pair.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your-kv-rest-token
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: in local development, if no KV credentials are set the app falls back to an
# in-memory store (rooms vanish on restart). It is refused in production unless you
# set JOYWATCH_ALLOW_MEMORY_STORE=1 (only for testing a production build locally).
